{
  "name": "samayak-admin-panel",
  "version": "2.6.0",
  "prisma": {
    "binaryTargets": ["native", "windows"]
  },
  "description": "Samayak Admin Panel — Academic Operations Platform",
  "private": true,
  "scripts": {
    "dev":          "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:worker":   "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "build":        "tsc --project tsconfig.json",
    "start":        "node dist/api/server.js",
    "start:worker": "node dist/workers/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy":  "prisma migrate deploy",
    "prisma:seed":    "ts-node --transpile-only prisma/seed.ts",
    "prisma:studio":  "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "bullmq":         "^5.4.0",
    "cors":           "^2.8.5",
    "csv-parse":      "^5.5.5",
    "bcryptjs":       "^2.4.3",
    "pino":           "^9.2.0",
    "express":        "^4.19.2",
    "helmet":         "^7.1.0",
    "ioredis":        "^5.3.2",
    "jsonwebtoken":   "^9.0.2",
    "multer":         "^1.4.5-lts.1",
    "pdfjs-dist":     "^4.2.67",
    "uuid":           "^9.0.1",
    "ws":             "^8.17.0",
    "xlsx":           "^0.18.5",
    "zod":            "^3.23.0"
  },
  "devDependencies": {
    "@types/cors":         "^2.8.17",
    "@types/express":      "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs":     "^2.4.6",
    "@types/multer":       "^1.4.11",
    "@types/node":         "^20.12.0",
    "@types/uuid":         "^9.0.8",
    "@types/ws":           "^8.5.10",
    "prisma":              "^5.12.0",
    "ts-node":             "^10.9.2",
    "ts-node-dev":         "^2.0.0",
    "typescript":          "^5.4.5"
  }
}
