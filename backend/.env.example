# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL="postgresql://samayak:change_me_locally@localhost:5432/samayak_db"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated allow-list; required in production, never "*"
CORS_ORIGIN=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_64_char_random_secret
# JWT_TTL_SECONDS=28800

# ── Seed (prisma:seed) ────────────────────────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@your-institution.edu
# SEED_PASSWORD=choose-a-strong-password   # omit to generate a random one (printed once)

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
