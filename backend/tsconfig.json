{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "commonjs",
    "lib":               ["ES2022"],
    "outDir":            "./dist",
    "rootDir":           "./src",
    "strict":            true,
    "strictNullChecks":  true,
    "noImplicitAny":     true,
    "esModuleInterop":   true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck":      true,
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata":  true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "frontend"]
}
